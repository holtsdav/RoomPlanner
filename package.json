{
  "name": "room-planner",
  "version": "0.1.0",
  "description": "A precise, blueprint-style 2D room planner for real furniture and devices.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests --maxWorkers=4",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "build:production": "node scripts/cloudflare.mjs build production",
    "build:develop": "node scripts/cloudflare.mjs build develop",
    "deploy:production": "node scripts/cloudflare.mjs deploy production",
    "deploy:develop": "node scripts/cloudflare.mjs deploy develop",
    "test:browser": "playwright test",
    "test:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "border-beam": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "embla-carousel-react": "8.6.0",
    "img-fx": "0.5.1",
    "input-otp": "1.5.0",
    "konva": "10.5.0",
    "liquid-gooey": "0.2.1",
    "lucide-react": "1.44.0",
    "metal-fx": "1.0.4",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-konva": "19.2.7",
    "react-resizable-panels": "4.12.4",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "thinking-orbs": "0.3.1",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "5.0.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
